encoding  utf-8
source draenen.th

input layout.thc
select draenen-plan

layout local
  copy draenen
  # Drawn passages' labels pile up at this scale; hidden for now.
  symbol-hide point label
  legend off
  # The header: length and depth, and who surveyed the newer surveys (the
  # Grade 2 data has no teams in it, so it's credited in the comment)
  statistics topo-length on
  map-comment "Survey data: the Grade 2 survey of Ogof Draenen by Oxford University Cave Club and the clubs and cavers named in its files (to 2003), with newer surveys by the teams below. Compiled in Therion by Rich Smith."
  doc-author "Rich Smith; survey data Oxford University Cave Club and others"
  scale 1 5000
  # Coloured by altitude: the drawings, and the ribbon along the centreline
  # (survey/plan.th), with the colours' key in the header
  colour map-fg altitude
  colour-legend smooth
  doc-title "Ogof Draenen"
endlayout

export model -fmt survex -o "draenen.3d"
# The stations and their surveys, for tools/plan.py to refer to them by
export database -o "draenen-stations.sql"
export map -proj plan -layout local -o "draenen-plan.pdf"
