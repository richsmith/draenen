encoding  utf-8

survey the-score -title "The Score"

  # Grade 2 placeholder: converted from the old Grade 2 Survex data.
  input grade2/thescore.th
  input grade2/abitontheside.th
  input grade2/onenightstand.th
  input grade2/extramaritalsex.th
  input grade2/crystalcruncher.th

  centreline
    equate 18@bitontheside 21@thescore	# abitontheside thescore
    equate 21@cryscruncher 8@crystalcrawl.cryscruncher	# crystalcruncher
    equate 27@cryscruncher 26@thescore	# crystalcruncher thescore
    equate 22@extramarital 19@thescore	# extramaritalsex thescore
    equate 17@onenight 2@ext.thescore	# onenightstand thescore
    equate 1@thescore 7@ext.thescore	# thescore
    equate 16@thescore 3@haggisbasher_2.thescore	# thescore
    equate 8@thescore 12@shithole.thescore	# thescore
  endcentreline

  # Junctions offered to the level above: zero-length legs naming
  # stations so the level above needn't know what's inside here.
  centreline
    sd length 0.001 metres
    data normal from to length compass clino
    22@thescore	score-junction	0	0	0
  endcentreline

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

endsurvey
