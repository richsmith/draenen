encoding  utf-8

survey bac-streamway -title "The Beyond A Choke streamway"

  # Grade 2 placeholder: converted from the old Grade 2 Survex data.
  input grade2/beyondachoke.th
  input grade2/rifleman.th
  input grade2/overthetop.th
  input grade2/oo.th
  input grade2/malcolm.th
  input grade2/fallout.th

  centreline
    equate 131@bac 56@malcolm	# beyondachoke malcolm
    equate 173@bac 13@overthetop	# beyondachoke overthetop
    equate 3@bac 25@rifleman	# beyondachoke rifleman
    equate 59@bac 13@fallout	# beyondachoke fallout
    equate 47@oo 5@overthetop	# oo overthetop
    equate 1@overthetop 1@ott2.overthetop	# overthetop
  endcentreline

  # Junctions offered to the level above: zero-length legs naming
  # stations so the level above needn't know what's inside here.
  centreline
    sd length 0.001 metres
    data normal from to length compass clino
    210@bac	tea-junction	0	0	0
    211@bac	ali1-passage	0	0	0
    213@bac	ali2-passage	0	0	0
    218@bac	ali3-passage	0	0	0
    229@bac	pitch-base	0	0	0
    221a@bac	cairn-junction	0	0	0
    1@oo	score-junction	0	0	0
  endcentreline

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

endsurvey
