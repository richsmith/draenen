encoding  utf-8

survey south -title "The South"

  input bac-streamway/bac-streamway.th
  input the-score/the-score.th

  # Grade 2 placeholder: converted from the old Grade 2 Survex data.
  centreline
    equate score-junction@bac-streamway score-junction@the-score	# oo thescore
  endcentreline

  # Junctions offered to the level above: zero-length legs naming
  # stations so the level above needn't know what's inside here.
  centreline
    sd length 0.001 metres
    data normal from to length compass clino
    tea-junction@bac-streamway	tea-junction	0	0	0
    ali1-passage@bac-streamway	ali1-passage	0	0	0
    ali2-passage@bac-streamway	ali2-passage	0	0	0
    ali3-passage@bac-streamway	ali3-passage	0	0	0
    pitch-base@bac-streamway	pitch-base	0	0	0
    cairn-junction@bac-streamway	cairn-junction	0	0	0
  endcentreline

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

endsurvey
