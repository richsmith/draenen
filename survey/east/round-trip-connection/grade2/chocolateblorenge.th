  # chamber above end of CBI
  1	21	5.4	124	+20
  21	22	1.0	-	down	# -90 strong draught
  22	23	5.7	73	0
  23	24	4.2	106	+10
  24	25	4.0	9	0
  25	25a	6.0	141	0
  25	26	13.2	354	0
  26	27	1.0	57	0
  27	27a	12.2	151	0
  27	28	20.2	351	0
  28	29	6.5	345	0
  29	30	3.9	350	0
  30	31	5.5	354	-20

  # Choclate Blorenge station G = Far Agent Blorenge station 46

  # Chocolate Blorenge station 31 = Far Agent Blorenge station 28

  # station from 21 onwards are one higher than those that appear in
