  f	g	5.0	318	0
  a	1	7.7	135	0	# A surveyed on 4/12/94
  1	2	2.0	-	up	# +90 start of Chocolate Blorenge Inlet
  2	3	5.7	338	0
  3	4	1.5	54	0
  4	5	11.3	323	0	# chamber 4m in diameter
  5	6	3.8	275	0
  6	7	5.0	342	+45
  7	16	3.2	326	0
  16	17	1.8	322	0
  17	18	4.4	302	0
  18	19	5.2	314	0
