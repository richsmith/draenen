endcentreline
endsurvey

# ;; XXX (pod): equate
# ;;*Equate PF2.11      \AB.FAB ; Far Agent Blorenge 46
# Presumed point of connection: confirmed by Ali

survey pf2

# 
# Second section surveyed on 19 Nov 94 after conservation work on formations in
# Gilwern passage.
# (We actually got a clino-reading!)
# 
# Iain Miller:  Instruments
# Ian Alderman: Notes
# Pete Francis: Tape, etc.
# Steve West:
# 

centreline
  # BCRA2
  sd length 0.5 metres
  sd compass clino 2.5 degrees
  calibrate compass 4.2
  data normal from to length compass clino
  1	2	2.50	047	0
  2	3	7.80	022	-30.0
  3	4	10.0	035	0
  4	5	3.9	015	0
  5	6	18.8	034	0
  6	7	12.60	153	0
  7	8	2.00	140	0
  8	9	15.00	150	0
  9	10	3.00	015	0
  10	11	7.00	150	0
  11	12	2.50	100	0

endcentreline
endsurvey

endsurvey
