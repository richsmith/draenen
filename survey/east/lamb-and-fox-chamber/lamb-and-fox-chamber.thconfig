encoding  utf-8
source lamb-and-fox-chamber.th

input ../../layout.thc
select lamb-and-fox-chamber

layout local
  copy draenen
  scale 1 500
  doc-title "Lamb and Fox Chamber"
endlayout

export model -fmt survex -o "lamb-and-fox-chamber.3d"
export map -proj plan -layout local -o "lamb-and-fox-chamber-plan.pdf"
