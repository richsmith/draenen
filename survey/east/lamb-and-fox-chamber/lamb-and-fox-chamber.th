encoding  utf-8

survey lamb-and-fox-chamber -title "Lamb and Fox Chamber"

  # Grade 2 placeholder: converted from the old Grade 2 Survex data.
  input grade2/hadeslamb.th

  # Junctions offered to the level above: zero-length legs naming
  # stations so the level above needn't know what's inside here.
  centreline
    sd length 0.001 metres
    data normal from to length compass clino
    14@hadeslamb	hades-lamb	0	0	0
  endcentreline

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

endsurvey
