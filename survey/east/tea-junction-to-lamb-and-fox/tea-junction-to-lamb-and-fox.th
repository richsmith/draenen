encoding  utf-8

survey tea-junction-to-lamb-and-fox -title "Tea Junction to Lamb and Fox Chamber"

  # Grade 2 placeholder: converted from the old Grade 2 Survex data.
  input grade2/whitearch.th
  input grade2/backpassage.th
  input grade2/walead1.th
  input grade2/walead2.th
  input grade2/walead3.th
  input grade2/flashsqueeze.th

  centreline
    equate 9@backpassage 34@walead_1 34@whitearch	# backpassage walead1 whitearch
    equate start@flashsqueeze 18a@walead_3	# flashsqueeze walead3
    equate 15@walead_2 15@whitearch	# walead2 whitearch
    equate 17@whitearch 18@whitearch	# whitearch
  endcentreline

  # Junctions offered to the level above: zero-length legs naming
  # stations so the level above needn't know what's inside here.
  centreline
    sd length 0.001 metres
    data normal from to length compass clino
    38@whitearch	tea-junction	0	0	0
    1@whitearch	indiana-raiders-white-arch	0	0	0
    8@walead_3	raiders-8	0	0	0
    4@whitearch	hades-lamb	0	0	0
    10@walead_3	raiders-10	0	0	0
  endcentreline

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

endsurvey
