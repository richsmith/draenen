encoding  utf-8

survey perseverance -title "Perseverance I and Fault Chambers"

  # Grade 2 placeholder: converted from the old Grade 2 Survex data.
  input grade2/nunnery.th
  input grade2/2perseverance.th
  input grade2/1perseverance.th
  input grade2/faultchambers.th
  input grade2/faultrifts.th
  input grade2/headachepassage.th
  input grade2/1rabbit.th

  centreline
    equate 17@faultchamber 10@perseverance_i	# 1perseverance faultchambers
    equate 2@faultchamber 30@faultrifts 22@headache	# faultchambers faultrifts headachepassage
    equate 5@nunnery 25@perseverance_i	# 1perseverance nunnery
    equate 9-1@nunnery 6@perseverance_ii	# 2perseverance nunnery
    equate 1@perseverance_i p1@perseverance_ii	# 1perseverance 2perseverance
    equate 22@perseverance_i 23@perseverance_i	# 1perseverance
    equate 4@perseverance_i 0@rabbitrun	# 1perseverance 1rabbit
  endcentreline

  # Junctions offered to the level above: zero-length legs naming
  # stations so the level above needn't know what's inside here.
  centreline
    sd length 0.001 metres
    data normal from to length compass clino
    7@faultchamber	elliptic-fault-chambers	0	0	0
    windy@nunnery	windy	0	0	0
    2@perseverance_i	make-it-up-perseverance	0	0	0
  endcentreline

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

endsurvey
