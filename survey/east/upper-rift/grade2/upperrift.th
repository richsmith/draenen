  6	7	2.5	315	+55
  7	8	2.8	335	0	# Slightly bigger! (walk/stoop) stream below
  8	9	3.3	290	0	# Small hole to R: 4.0m 015deg ends in small tube
  9	9a	4.0	015	0	# Tube described above -- TPL
  9	10	6.6	330	0	# Formation! At upper level, stream through crawl below
  10	11	2.8	275	0
  11	12	2.7	300	0
  12	13	3.1	310	0	# Hole on L to dig, 8.3m 190deg
  12	12a	8.3	190	0	# Side passage described above -- TPL
