encoding  utf-8

survey going-square -title "Going Square"

  # Grade 2 placeholder: converted from the old Grade 2 Survex data.
  input grade2/goingsquare.th
  input grade2/gosqend.th
  input grade2/makeitup.th

  centreline
    equate 10@goingsquare 0@makeitup	# goingsquare makeitup (inferred)
    equate 2@goingsquare 10@squareend	# goingsquare gosqend
  endcentreline

  # Junctions offered to the level above: zero-length legs naming
  # stations so the level above needn't know what's inside here.
  centreline
    sd length 0.001 metres
    data normal from to length compass clino
    windy@goingsquare	windy	0	0	0
    32@makeitup	make-it-up-perseverance	0	0	0
  endcentreline

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

endsurvey
