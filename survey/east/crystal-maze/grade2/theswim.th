  6	7	9.4	20	0
  7	8	9.4	20	0
  8	9	2.2	359	0	# 9 = first dug breakthrough
  9	10	6.3	61	0
  10	11	9.4	24	0	# Hanging Gardens a superb formation
  11	12	15.6	332	0	# 12 = Crystal Maze station 1
  12	13	7.9	97	0
  13	14	13.4	358	0
