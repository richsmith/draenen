encoding  utf-8
source elliptic-passage.th

input ../../layout.thc
select elliptic-passage

layout local
  copy draenen
  scale 1 500
  doc-title "Elliptic Passage and beyond"
endlayout

export model -fmt survex -o "elliptic-passage.3d"
export map -proj plan -layout local -o "elliptic-passage-plan.pdf"
