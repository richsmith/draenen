encoding  utf-8

survey canyon-passages -title "The Canyon Passages"

  # Grade 2 placeholder: converted from the old Grade 2 Survex data.
  input grade2/canyoneast.th
  input grade2/canyonwest.th
  input grade2/canyonhades.th
  input grade2/canyonsouth.th
  input grade2/tractortrack.th
  input grade2/bigmole.th

  centreline
    equate 44b@canyon_e 1@canyon_hcc 1c@canyon_w	# canyoneast canyonhades canyonwest
    equate 60c@canyon_e 68b@canyon_e	# canyoneast
    equate 55@canyon_hcc 80@canyon_s	# canyonhades canyonsouth
    equate a@canyon_hcc a@hcc_bmp	# bigmole canyonhades
    equate 25@canyon_s 25t@hcc_tt	# canyonsouth tractortrack
  endcentreline

  # Junctions offered to the level above: zero-length legs naming
  # stations so the level above needn't know what's inside here.
  centreline
    equate 29c@canyon_e 29c@canyon_w
    sd length 0.001 metres
    data normal from to length compass clino
    29c@canyon_e	canyon-indiana-highway	0	0	0
    28c@canyon_w	canyon-west-hilevel3	0	0	0
  endcentreline

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

endsurvey
