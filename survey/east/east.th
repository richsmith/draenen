encoding  utf-8

survey east -title "The East and the 'Round Trip' route"

  input tea-junction-to-lamb-and-fox/tea-junction-to-lamb-and-fox.th
  input lamb-and-fox-chamber/lamb-and-fox-chamber.th
  input indiana-highway/indiana-highway.th
  input megadrive/megadrive.th
  input round-trip-connection/round-trip-connection.th
  input raiders-passage/raiders-passage.th
  input canyon-passages/canyon-passages.th
  input underworld/underworld.th
  input black-beetle/black-beetle.th
  input going-square/going-square.th
  input upper-rift/upper-rift.th
  input wooden-spoon/wooden-spoon.th
  input life-on-mars/life-on-mars.th
  input crystal-maze/crystal-maze.th
  input perseverance/perseverance.th
  input elliptic-passage/elliptic-passage.th
  input wyvern/wyvern.th

  # Grade 2 placeholder: converted from the old Grade 2 Survex data.
  centreline
    equate canyon-indiana-highway@canyon-passages canyon-indiana-highway@indiana-highway	# canyoneast canyonwest indianahighway
    equate canyon-west-hilevel3@canyon-passages canyon-west-hilevel3@indiana-highway	# canyonwest hilevel3
    equate elliptic-fault-chambers@elliptic-passage elliptic-fault-chambers@perseverance	# elliptic faultchambers
    equate elliptic-wyvern@elliptic-passage elliptic-wyvern@wyvern	# elliptic wyvern (inferred)
    equate windy@going-square windy@megadrive windy@perseverance	# goingsquare megadrive nunnery
    equate make-it-up-perseverance@going-square make-it-up-perseverance@perseverance	# 1perseverance makeitup (inferred)
    equate hilevel3-underworld@indiana-highway hilevel3-underworld@underworld	# hilevel3 underworld
    equate indiana-raiders-white-arch@indiana-highway indiana-raiders-white-arch@raiders-passage indiana-raiders-white-arch@tea-junction-to-lamb-and-fox	# indianahighway raiderspassage whitearch
    equate indiana-megadrive@indiana-highway indiana-megadrive@megadrive	# indianahighway megadrive
    equate raiders-8@indiana-highway raiders-8@raiders-passage raiders-8@tea-junction-to-lamb-and-fox	# indianahighway raiderspassage walead3
    equate hades-lamb@lamb-and-fox-chamber hades-lamb@tea-junction-to-lamb-and-fox	# hadeslamb whitearch
    equate raiders-10@raiders-passage raiders-10@tea-junction-to-lamb-and-fox	# raiderspassage walead3
    equate arms-park@perseverance arms-park@round-trip-connection	# erection swallow
    equate upper-rift-pitch@round-trip-connection upper-rift-pitch@upper-rift	# squirrel upperrift
    equate wa-connection-squirrel@round-trip-connection wa-connection-squirrel@upper-rift	# squirrel waconnection
    equate tube-surprise-ab3@round-trip-connection tube-surprise-ab3@upper-rift	# 3blorenge tube
    equate surprise-squirrel@round-trip-connection surprise-squirrel@upper-rift	# squirrel surprise
    equate wooden-spoon-ab2@round-trip-connection wooden-spoon-ab2@wooden-spoon	# 2blorenge woodenspoon
    equate mars1-squirrel2@life-on-mars mars1-squirrel2@round-trip-connection	# mars1 sq2
    equate wooden-spoon-round-trip@round-trip-connection wooden-spoon-round-trip@wooden-spoon	# roundtripconnection woodenspoon
    equate wooden-spoon-ac1@round-trip-connection wooden-spoon-ac1@wooden-spoon	# ac1 woodenspoon
    equate chocolate-crystal-maze@crystal-maze chocolate-crystal-maze@round-trip-connection	# chocolateblorenge crystalmaze
    equate rift-mars-squirrel2@life-on-mars rift-mars-squirrel2@round-trip-connection	# riftmars sq2
    equate rift-mars-round-trip@life-on-mars rift-mars-round-trip@round-trip-connection	# riftmars roundtripconnection
  endcentreline

  # Junctions offered to the level above: zero-length legs naming
  # stations so the level above needn't know what's inside here.
  centreline
    sd length 0.001 metres
    data normal from to length compass clino
    elliptic-lucky-13@elliptic-passage	elliptic-lucky-13	0	0	0
    tea-junction@tea-junction-to-lamb-and-fox	tea-junction	0	0	0
    agent-blorenge@round-trip-connection	agent-blorenge	0	0	0
  endcentreline

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

endsurvey
