encoding  utf-8

survey indiana-highway -title "Indiana Highway"

  # Grade 2 placeholder: converted from the old Grade 2 Survex data.
  input grade2/indianahighway.th
  input grade2/hilevel2.th
  input grade2/hilevel3.th
  input grade2/destiny.th

  centreline
    equate 18@destiny 163@indiana	# destiny indianahighway
    equate 7@hilevel2 7@hilevel3	# hilevel2 hilevel3
    equate 7a@hilevel2 155@indiana	# hilevel2 indianahighway
  endcentreline

  # Junctions offered to the level above: zero-length legs naming
  # stations so the level above needn't know what's inside here.
  centreline
    sd length 0.001 metres
    data normal from to length compass clino
    158@indiana	canyon-indiana-highway	0	0	0
    24@hilevel3	canyon-west-hilevel3	0	0	0
    1@hilevel3	hilevel3-underworld	0	0	0
    1@indiana	indiana-raiders-white-arch	0	0	0
    157@indiana	indiana-megadrive	0	0	0
    8@indiana	raiders-8	0	0	0
  endcentreline

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

endsurvey
