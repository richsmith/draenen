encoding  utf-8

survey wyvern -title "The Wyvern Extensions - Wessex Series"

  # Grade 2 placeholder: converted from the old Grade 2 Survex data.
  input grade2/wyvern.th

  centreline
    equate 4@mg.wyvern mg4@a.mg.wyvern	# wyvern
    equate ml8@mg.wyvern 8@ml.wyvern	# wyvern
    equate 38@ml.wyvern ml38@wl.wyvern	# wyvern
    equate 61@ml.wyvern ml61@wh.wyvern	# wyvern
    equate 3@wl.wyvern wl3@wla.wyvern	# wyvern
    equate 4@wl.wyvern wl4@wlb.wyvern	# wyvern
    equate 2@wla.wyvern wla2@wlb.wyvern	# wyvern
  endcentreline

  # Junctions offered to the level above: zero-length legs naming
  # stations so the level above needn't know what's inside here.
  centreline
    sd length 0.001 metres
    data normal from to length compass clino
    15@wh.wyvern	elliptic-wyvern	0	0	0
  endcentreline

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

endsurvey
