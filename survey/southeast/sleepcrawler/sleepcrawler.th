encoding  utf-8

survey sleepcrawler -title "Sleepcrawler Series & War Of The Worlds"

  # Grade 2 placeholder: converted from the old Grade 2 Survex data.
  input grade2/wow.th
  input grade2/bloodrvr.th

  centreline
    equate 1@apass 2a@aside 7a@aside	# wow
    equate 2a@apass 35@inca	# wow
    equate 8@apass 9a@aside	# wow
    equate 1@black 26@scext	# wow
    equate 2@black 0@ski	# wow
    equate 6@black 8@sleep3	# wow
    equate 7@black 1@gypsum	# wow
    equate 1@blodrvr1 2@blood	# bloodrvr wow
    equate 11@blodrvr1 0@pow	# bloodrvr
    equate 18@blodrvr1 0@blodrvr2	# bloodrvr
    equate 13@blodrvr2 12a@pow	# bloodrvr
    equate 38@blodrvr2 34a@pow	# bloodrvr
    equate 17@blood 42@inca	# wow
    equate 4@gypsum 25@lost	# wow
    equate 3a@hicamp 4@lost3	# wow
    equate 20@inca 1a@lost3 18@meno	# wow
    equate 59@killtom 33@lost2	# wow
    equate 1@lost a@lost1	# wow
    equate 21@lost 18@tom	# wow
    equate 7@lost 0@tom	# wow
    equate 9@lost1 9@lost2	# wow
    equate 54@lost2 7b@lost3	# wow
    equate 1@scdig 1@scext	# wow
    equate 2@scdig 2@scpass	# wow
  endcentreline

  # Junctions offered to the level above: zero-length legs naming
  # stations so the level above needn't know what's inside here.
  centreline
    equate 18@black 7@fly
    sd length 0.001 metres
    data normal from to length compass clino
    18@black	war-of-the-worlds	0	0	0
  endcentreline

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

endsurvey
