encoding  utf-8

layout local
  debug off
  map-header 0 0 off
  symbol-hide group cave-centreline
endlayout

source "rainbow-canyon.th"

export model -fmt survex -o "rainbow-canyon-th.3d"

export map -proj plan -layout local -o "rainbow-canyon-plan.pdf"

# export map -proj extended -layout local -o "rainbow-canyon-ee.pdf"
