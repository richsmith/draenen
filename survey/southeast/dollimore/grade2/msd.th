# Converted from the old Grade 2 Survex data (Grade2/Grade2/msd.svx).

# ;;;;;;;; MS&D
# including Grotto Passage, etc

# Connections

# Survey connection from Last Sandwich to MS&D
# Discovered Gavin Lowe, Steve Roberts, Nathaniel Mumford and Jonathan Cooper
# 16.11.96
# Surveyed Pauline Rigby, Tim Guilford, Jonathan Cooper
# 24.11.96
# Book PAR, instruments TCG, tape JC
# Instrument Set ?
# zero readings are guessed!

survey connect
# From   To      Tape    Compass Clino
centreline
  # BCRA2
  sd length 0.5 metres
  sd compass clino 2.5 degrees
  calibrate compass 4.2
  data normal from to length compass clino
  1	0	10.8	154	-26	# 0 = MSAD station 0
  2	1	12.6	156	-12
  3	2	4.0	161.5	+15	# 3 = exit from 2nd dig
  3	4	1.4	336	-41
  5	4	10.6	117.5	+2
  6	5	10.3	132.5	+6
  7	6	3.5	118	+37	# 7 = exit from 1st dig
  8	7	2.5	152	+14
  9	8	2.1	167	+25
  10	9	3.7	153	-12
  11	10	0.7	148	-26
  11	12	1.0	-	up	# 12 = grovelling south station 1
endcentreline
endsurvey

# MS&D
# Discovered and surveyed Gavin Lowe, Steve Roberts, Jonathan Cooper, Nobby
# Mumford
# 16/11/96.
# Notes Gavin, Tape Nobby, Instr Steve
# Along MS&D passage.

survey msdright
# Station 0 is the lower of the two cairns, at the break through point
centreline
  # BCRA2
  sd length 0.5 metres
  sd compass clino 2.5 degrees
  calibrate compass 4.2
  data normal from to length compass clino
  0	1	22.0	234	10
  2	1	11.1	55	5
  3	2	26.9	37	5
  # Station 3 is a cairn
  3	4	27.6	187	0
  5	4	18.6	36	-15
  # Station 5 is a cairn, with a very large passage going off right
  5	6	30.2	198	-9
  7	6	28.6	1	13
  # Station 7 is a cairn, just after Jolted Jon
  7	8	27.3	186	-3
  9	8	13.0	22	-7
  9	10	11.3	228	-14
  # Station 10 is a cairn, at the junction with the upstream streamway (Out of
  # the Blue)
  11	10	19.1	92	-7
  11	12	25.4	216	12
  # Station 12 is a cairn, just back from the climb down to the downstream
  # streamway
  13	12	5.5	54	2
  13	14	22.9	193	-39
  # Station 14 is a cairn, just below the climb, at the start of Into the Black
endcentreline
endsurvey

# Nicola's Grotto
# Discovered and surveyed 23.11.96
# Gavin Lowe, Steve Roberts, Peter Bolt, Kevin "the Squaddie"
# All clino readings are estimates

survey nicgrotto
centreline
  # BCRA2
  sd length 0.5 metres
  sd compass clino 2.5 degrees
  calibrate compass 4.2
  data normal from to length compass clino
  1	0	20.35	94	-35	# station 1 is cairn at top of boulder slope
  1	2	7.63	7	0
  3	2	29.9	126	0	# station 3 is scratched triangle on right
  # wall
  3	4	27.0	305	0
  5	4	18.35	129	0	# station 5 is scratched triangle on right
  # wall
  5	6	6.00	307	0	# station 6 is cairn at crossroads
  7	6	15.45	120	0	# station 7 is in Nicola's Grotto

  # The passage straight on chokes; the passage to the right should not be
  # entered

  8	7	7.80	65	0
  8	9	25.15	215	0	# station 9 is cairn (?)
  # 6       10      21.0    31      - ;included in offgrot survey with more legs
endcentreline
endsurvey

