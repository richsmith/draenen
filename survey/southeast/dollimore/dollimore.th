encoding  utf-8

survey dollimore -title "Dollimore Series"

  # Grade 2 placeholder: converted from the old Grade 2 Survex data.
  input grade2/dollimor.th
  input grade2/cantank.th

  centreline
    equate 01@cantank l53@luck	# cantank lotd
    equate 10@circus1 40@dogleg1	# itb
    equate 9@circus1 39@dogleg1	# itb
    equate 8@clique 5@msdright 9@pigscream	# msd
    equate 0@connect 1@msdleft 0@msdright	# msd
    equate 0@dogleg1 16@inblack1	# itb
    equate 12@dogleg1 pt1@negthumg	# itb lotd
    equate 10@glitz 10@lotdlink k0@luck	# lotd
    equate l5@gobbler l5@luck	# lotd
    equate 14@inblack1 14@msdright	# itb msd
    equate 24@inblack1 0@inblack2	# itb
    equate 4@inblack2 12@yellowvan	# itb
    equate 12@lotdlink 4@negthumg	# lotd
    equate 15@lotdlink k4@luck	# lotd
    equate a12@luck 12@msdright 0@nicgrotto	# lotd msd
    equate l2@luck 1@whinger	# lotd
    equate l34@luck 1@sideluck34	# lotd
    equate l40@luck 14@sideluck40	# lotd
    equate l42@luck 23@sideluck42	# lotd
    equate l56@luck 0@luck2	# lotd
    equate 65@luck2 11@sideluck65	# lotd
    equate 79@luck2 0@luck3	# lotd
    equate 10@msdright 1@outblue1	# msd ootb
    equate 1@nicgrotto d1@offgrot	# msd
    equate 6@nicgrotto d6@offgrot	# msd
    equate 21@outblue1 j1@outblue2	# ootb
    equate 1@pigscream 108@pisspot	# msd
    equate 13@sideluck34 4@sideluck34b	# lotd
    equate 42@sideluck42 12@sideluck42b	# lotd
    equate 15c@testarosaa 11@yellowvan	# itb
    equate 8@testarosaa a8@testarosab	# itb
    equate 6@yellowvan 11@yellowvan2	# itb
  endcentreline

  # Junctions offered to the level above: zero-length legs naming
  # stations so the level above needn't know what's inside here.
  centreline
    sd length 0.001 metres
    data normal from to length compass clino
    12@connect	last-sandwich	0	0	0
  endcentreline

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

  # Not tied in yet: see southeast.th.
  # input rainbow-canyon/2021-10-19-rainbow-canyon/rainbow-canyon.th

endsurvey
