encoding  utf-8

survey lucky-13 -title "The Lucky Thirteen Extensions"

  # Grade 2 placeholder: converted from the old Grade 2 Survex data.
  input grade2/lucky13.th
  input grade2/gwtw.th
  input grade2/gity.th
  input grade2/exodus.th
  input grade2/gosome.th
  input grade2/3amigos.th
  input grade2/hexamine.th

  centreline
    equate 0@lhs.3amigos 0@rhs.3amigos	# 3amigos
    equate 13@lhs.3amigos 0@a.lhs.3amigos 8@b.lhs.3amigos	# 3amigos
    equate 18@lhs.3amigos 0@c.lhs.3amigos	# 3amigos
    equate 21@lhs.3amigos 0@d.lhs.3amigos	# 3amigos
    equate 3@a.lhs.3amigos 0@b.lhs.3amigos	# 3amigos
    equate 6@rhs.3amigos 10@waterfall_1.rhs.3amigos	# 3amigos
    equate x@rhs.3amigos 1@gity_ext	# 3amigos gity (inferred)
    equate s2@anon 2@snowball	# gity
    equate 2@exodus 38@sandwich	# exodus
    equate 9@exodus 5@snowball	# exodus gity
    equate 13@gith 27@gity_south	# gity
    equate 1@gity 13@gwtw	# gity gwtw
    equate 14@gity 0@gity_south	# gity
    equate 18@gity 14@gity_ext 10@side3.gity_ext	# gity
    equate 4@gity_ext 7@side1.gity_ext	# gity
    equate 9@gity_ext 6@side2.gity_ext	# gity
    equate 17@gity_south 39@rogered	# gity
    equate 1@gosome 1@rogered 1@snowball	# gity gosome
    equate 15@gwtw 17@lucky13	# gwtw lucky13
    equate 31@sandwich 32@sandwich	# exodus
    equate 35@sandwich tls35@uppersand	# exodus
    # Hexamine Highways joins Mid-Winter Chambers at old Grade 5 station 42.
    # PROVISIONAL: taken as GITY_South 1, a right-angle bend where the survey
    # turns east and Hexamine carries straight on south.
    equate st.42@hexamine 1@gity_south	# gity hexamine
    equate g6@hexamine st.42@hexamine	# hexamine: "G6 also has a connection with ST.42"
  endcentreline

  # Junctions offered to the level above: zero-length legs naming
  # stations so the level above needn't know what's inside here.
  centreline
    equate 23@lhs.3amigos 0@e.lhs.3amigos
    sd length 0.001 metres
    data normal from to length compass clino
    1@lucky13	elliptic-lucky-13	0	0	0
    23@lhs.3amigos	big-country-junction	0	0	0
    1@sandwich	last-sandwich	0	0	0
    13@snowball	war-of-the-worlds	0	0	0
  endcentreline

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

endsurvey
