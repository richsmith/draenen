encoding  utf-8

survey southeast -title "The Southeast"

  input lucky-13/lucky-13.th
  input big-country/big-country.th
  input dollimore/dollimore.th
  input sleepcrawler/sleepcrawler.th

  # Grade 2 placeholder: converted from the old Grade 2 Survex data.
  centreline
    equate big-country-junction@big-country big-country-junction@lucky-13	# 3amigos bigc (inferred)
    equate last-sandwich@dollimore last-sandwich@lucky-13	# exodus msd
    equate war-of-the-worlds@lucky-13 war-of-the-worlds@sleepcrawler	# gity wow
  endcentreline

  # Junctions offered to the level above: zero-length legs naming
  # stations so the level above needn't know what's inside here.
  centreline
    sd length 0.001 metres
    data normal from to length compass clino
    elliptic-lucky-13@lucky-13	elliptic-lucky-13	0	0	0
  endcentreline

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

  # Rainbow Canyon (input in dollimore/dollimore.th) probably ties in at the
  # "rainbow choke" in bloodrvr.svx:
  # centreline
  #   equate 1@rainbow-canyon.dollimore 33@blodrvr2.sleepcrawler
  # endcentreline

endsurvey
