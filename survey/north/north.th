encoding  utf-8

survey north -title "The North"

  input upstream-passage/upstream-passage.th
  input waterfall-series/waterfall-series.th
  input knees-up-mother-brown/knees-up-mother-brown.th
  input bolder-land/bolder-land.th

  # Grade 2 placeholder: converted from the old Grade 2 Survex data.
  centreline
    equate knees-up@knees-up-mother-brown knees-up@waterfall-series	# knees_pb out yes (inferred)
    equate waterfall-junction@upstream-passage waterfall-junction@waterfall-series	# upstreampassage water_a (inferred)
    equate bolder-land-junction@knees-up-mother-brown bolder-land-junction@bolder-land	# bolderpb padlock
  endcentreline

  # Junctions offered to the level above: zero-length legs naming
  # stations so the level above needn't know what's inside here.
  centreline
    sd length 0.001 metres
    data normal from to length compass clino
    pitch-base@upstream-passage	pitch-base	0	0	0
  endcentreline

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

  # Tarddiad Pwll Du, fixed at its own entrance (see tarddiad.th).
  # PROVISIONAL tie, until it's checked underground: Tarddiad-lower is taken
  # as a resurvey of Upstream Passage's streamway. Laid on Upstream Passage,
  # its stations 102-112 follow Upstream 6-12 to within 3 m (113-114 is the
  # 3 m waterfall's inlet), so it's tied at the end of that stretch,
  # 111 = Upstream 12. Upstream Passage's Grade 2 survey has no clinos, so
  # heights along it are rough.
  input tarddiad-pwll-du/tarddiad.th
  centreline
    equate 111@Tarddiad-lower.Tardiadd tarddiad@upstream-passage
  endcentreline

  # Plan maps.  drawn-plan lists the maps of every drawn survey in the North.
  map drawn-plan -proj plan
    tarddiad-plan@Tardiadd
  endmap

endsurvey

# The plan: survey lines of everything in the North, including the Grade 2, plus the
# drawings.  It's outside the survey so it can refer to the survey itself.
map north-plan -proj plan -title "The North"
  north
  drawn-plan@north
endmap
