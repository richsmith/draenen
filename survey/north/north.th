encoding  utf-8

survey north -title "The North"

  input upstream-passage/upstream-passage.th
  input waterfall-series/waterfall-series.th
  input knees-up-mother-brown/knees-up-mother-brown.th
  input bolder-land/bolder-land.th

  # Grade 2 placeholder, generated by tools/svx2th.py.
  input grade2.th

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

  # Tarddiad Pwll Du ties in to the Waterfall Series somewhere; uncomment once
  # the tie station is known.  Waterfall A.2 is noted as "Grade 5 survey
  # marker at base of waterfall series initial climb", so might be a start.
  # input tarddiad-pwll-du/tarddiad.th
  # centreline
  #   equate <stn>@Tarddiad.Tardiadd 2@a.waterfall.waterfall-series
  # endcentreline

endsurvey
