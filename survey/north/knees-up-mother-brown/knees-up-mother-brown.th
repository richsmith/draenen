encoding  utf-8

survey knees-up-mother-brown -title "Knees Up Mother Brown and beyond"

  # Grade 2 placeholder: converted from the old Grade 2 Survex data.
  input grade2/knees_pb.th
  input grade2/lostrivr.th
  input grade2/knees_ag.th
  input grade2/yes.th
  input grade2/padlock.th

  centreline
    equate 5@pb.kneesup 5@ag.kneesup_2 kneesup@lostriver	# knees_ag knees_pb lostrivr (inferred)
    equate 1@padlock 30@yes	# padlock yes (inferred)
  endcentreline

  # Junctions offered to the level above: zero-length legs naming
  # stations so the level above needn't know what's inside here.
  centreline
    equate 27@pb.kneesup 1@yes
    sd length 0.001 metres
    data normal from to length compass clino
    27@pb.kneesup	knees-up	0	0	0
    13@padlock	bolder-land-junction	0	0	0
  endcentreline

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

endsurvey
