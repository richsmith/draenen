  10	11	9	177	0
  11	12	14.95	129	0
  12	13	8.68	178	0
  13	14	8.28	137	0	# side passage 4m at 142 degrees
  14	15	7.75	195	0
  15	16	17.7	141	0
  16	17	17.85	44	0
  17	18	11.1	73	0
  18	19	11.8	165	0
  19	20	16.23	150	0
  20	21	4.6	126	0
  21	22	30	154	0
  22	23	8.1	40	0
