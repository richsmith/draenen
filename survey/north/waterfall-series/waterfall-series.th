encoding  utf-8

survey waterfall-series -title "Waterfall Series to Knees Up Mother Brown"

  # Grade 2 placeholder: converted from the old Grade 2 Survex data.
  input grade2/water_a.th
  input grade2/water_b.th
  input grade2/out.th

  centreline
    equate 20@out 21@out	# out
    equate 38@out 39@out	# out
    equate waterfall@out 9@b.waterfall_2	# out water_b (inferred)
    equate a41@a.waterfall 29@b.waterfall_2	# water_a water_b (inferred)
  endcentreline

  # Junctions offered to the level above: zero-length legs naming
  # stations so the level above needn't know what's inside here.
  centreline
    sd length 0.001 metres
    data normal from to length compass clino
    1@out	knees-up	0	0	0
    1@a.waterfall	waterfall-junction	0	0	0
  endcentreline

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

endsurvey
