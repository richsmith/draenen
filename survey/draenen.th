encoding  utf-8

survey draenen -title "Ogof Draenen"

  input entrance/entrance.th
  input north/north.th
  input south/south.th
  input northwest/northwest.th
  input east/east.th
  input southeast/southeast.th

  # Grade 2 placeholder: converted from the old Grade 2 Survex data.
  # Not linked to the rest of the cave, so left out: one leg of bigc.

  centreline
    equate elliptic-lucky-13@east elliptic-lucky-13@southeast	# elliptic lucky13
    equate tea-junction@east tea-junction@northwest tea-junction@south	# beyondachoke gilwernpassage whitearch
    equate ali1-passage@entrance ali1-passage@south	# ali1 beyondachoke
    equate ali2-passage@entrance ali2-passage@south	# ali2 beyondachoke
    equate ali3-passage@entrance ali3-passage@south	# ali3 beyondachoke
    equate pitch-base@entrance pitch-base@north pitch-base@south	# beyondachoke darlingrift upstreampassage
    equate cairn-junction@entrance cairn-junction@south	# beyondachoke sparerib strawberrypassage (inferred)
    equate agent-blorenge@south agent-blorenge@east	# 1blorenge beyondachoke
  endcentreline

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

  # Plan maps.  drawn-plan lists the drawn-plan of each section that has
  # drawings.
  map drawn-plan -proj plan
    drawn-plan@north
  endmap


endsurvey

# The plan: survey lines of everything, including the Grade 2, plus the
# drawings.  It's outside the survey so it can refer to the survey itself.
map draenen-plan -proj plan -title "Ogof Draenen"
  draenen
  drawn-plan@draenen
endmap
