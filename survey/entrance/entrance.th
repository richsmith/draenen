encoding  utf-8

survey entrance -title "The Entrance"

  input entrance-series/entrance-series.th
  input strawberry-passage/strawberry-passage.th
  input cairn-to-tea-junction/cairn-to-tea-junction.th

  # Junctions offered to the level above: zero-length legs naming
  # stations so the level above needn't know what's inside here.
  centreline
    equate cairn-junction@entrance-series cairn-junction@strawberry-passage
    sd length 0.001 metres
    data normal from to length compass clino
    ali1-passage@cairn-to-tea-junction	ali1-passage	0	0	0
    ali2-passage@cairn-to-tea-junction	ali2-passage	0	0	0
    ali3-passage@cairn-to-tea-junction	ali3-passage	0	0	0
    pitch-base@entrance-series	pitch-base	0	0	0
    cairn-junction@entrance-series	cairn-junction	0	0	0
  endcentreline

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

endsurvey
