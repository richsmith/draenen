encoding  utf-8
source cairn-to-tea-junction.th

input ../../layout.thc
select cairn-to-tea-junction

layout local
  copy draenen
  scale 1 500
  doc-title "Cairn Junction to Tea Junction"
endlayout

export model -fmt survex -o "cairn-to-tea-junction.3d"
export map -proj plan -layout local -o "cairn-to-tea-junction-plan.pdf"
