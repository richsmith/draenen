encoding  utf-8

survey entrance-series -title "Entrance Series"

  # Grade 2 placeholder: converted from the old Grade 2 Survex data.
  input grade2/entrance.th
  input grade2/darlingrift.th
  input grade2/sparerib.th
  input grade2/pbcrawl.th

  centreline
    equate 1@darling 13@entrance	# darlingrift entrance
    equate 13@darling 22@sparerib	# darlingrift sparerib
    equate 1@sparerib 1@pbcrawl	# pbcrawl sparerib
  endcentreline

  # Junctions offered to the level above: zero-length legs naming
  # stations so the level above needn't know what's inside here.
  centreline
    sd length 0.001 metres
    data normal from to length compass clino
    ladder@darling	pitch-base	0	0	0
    1@sparerib	cairn-junction	0	0	0
  endcentreline

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

endsurvey

