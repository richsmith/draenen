encoding  utf-8

survey bac-to-forever-changed -title "The Beyond A Choke streamway to Forever Changed"

  # Grade 2 placeholder: converted from the old Grade 2 Survex data.
  input grade2/gilwernpassage.th
  input grade2/morgannwgpassage.th
  input grade2/rip.th

  centreline
    equate 1@gilwern 5@illtydians.gilwern 5@side2.gilwern	# gilwernpassage
    equate 30@gilwern 8@rip	# gilwernpassage rip
    equate 1@side2.gilwern 31@morgannwg	# gilwernpassage morgannwgpassage (inferred)
  endcentreline

  # Junctions offered to the level above: zero-length legs naming
  # stations so the level above needn't know what's inside here.
  centreline
    sd length 0.001 metres
    data normal from to length compass clino
    32@gilwern	tea-junction	0	0	0
    4@illtydians.gilwern	garimpeiros-junction	0	0	0
  endcentreline

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

endsurvey
