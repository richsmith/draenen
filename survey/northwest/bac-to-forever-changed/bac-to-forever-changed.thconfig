encoding  utf-8
source bac-to-forever-changed.th

input ../../layout.thc

layout local
  copy draenen
  scale 1 500
  doc-title "The Beyond A Choke streamway to Forever Changed"
endlayout

export model -fmt survex -o "bac-to-forever-changed.3d"
export map -proj plan -layout local -o "bac-to-forever-changed-plan.pdf"
