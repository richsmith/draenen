encoding  utf-8
source y-gwter-fawr.th

input ../../layout.thc
select y-gwter-fawr

layout local
  copy draenen
  scale 1 500
  doc-title "The Y Gwter Fawr Streamway (Breadfruit Boulevard and Saint Giles Series)"
endlayout

export model -fmt survex -o "y-gwter-fawr.3d"
export map -proj plan -layout local -o "y-gwter-fawr-plan.pdf"
