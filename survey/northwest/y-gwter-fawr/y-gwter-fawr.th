encoding  utf-8

survey y-gwter-fawr -title "The Y Gwter Fawr Streamway (Breadfruit Boulevard and Saint Giles Series)"

  # Grade 2 placeholder: converted from the old Grade 2 Survex data.
  input grade2/wiggly.th
  input grade2/stgiles.th
  input grade2/breadfrt.th
  input grade2/wiggly2.th
  input grade2/sanitizer.th
  input grade2/clerical.th

  centreline
    equate 20@breadfruit 30@stgiles	# breadfrt stgiles
    equate 17@clerical 9@stgiles	# clerical stgiles
    equate 17@sanitizer 15@mr_ugg.sanitizer	# sanitizer
    equate 35@sanitizer 3@t.sanitizer	# sanitizer
    equate 9@sanitizer 7@branch9.sanitizer	# sanitizer
    equate 1@t.sanitizer 13@stgiles 21@wiggly	# sanitizer stgiles wiggly
    equate 72@wiggly 18@wiggly2	# wiggly wiggly2
  endcentreline

  # Junctions offered to the level above: zero-length legs naming
  # stations so the level above needn't know what's inside here.
  centreline
    sd length 0.001 metres
    data normal from to length compass clino
    1@breadfruit	breadfruit-junction	0	0	0
    3@stgiles	lamb-and-flag-junction	0	0	0
  endcentreline

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

endsurvey
