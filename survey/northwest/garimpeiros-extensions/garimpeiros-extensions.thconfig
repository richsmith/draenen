encoding  utf-8
source garimpeiros-extensions.th

input ../../layout.thc

layout local
  copy draenen
  scale 1 500
  doc-title "Forever Changed to Hearts of Olden Glory (The Galeria Garimpeiros Extensions)"
endlayout

export model -fmt survex -o "garimpeiros-extensions.3d"
export map -proj plan -layout local -o "garimpeiros-extensions-plan.pdf"
