encoding  utf-8

survey northwest -title "The Northwest (Gilwern Passage and beyond)"

  input bac-to-forever-changed/bac-to-forever-changed.th
  input garimpeiros-extensions/garimpeiros-extensions.th
  input another-world/another-world.th
  input indigo-rift/indigo-rift.th
  input baron-von-carno/baron-von-carno.th
  input y-gwter-fawr/y-gwter-fawr.th
  input lamb-and-flag/lamb-and-flag.th
  input dyar-straits/dyar-straits.th

  # Grade 2 placeholder: converted from the old Grade 2 Survex data.
  centreline
    equate garimpeiros-junction@bac-to-forever-changed garimpeiros-junction@garimpeiros-extensions	# garimpeiros gilwernpassage
    equate breadfruit-junction@garimpeiros-extensions breadfruit-junction@y-gwter-fawr	# breadfrt garimpeiros
    equate lamb-and-flag-junction@lamb-and-flag lamb-and-flag-junction@y-gwter-fawr	# flag lamb stgiles
  endcentreline

  # Junctions offered to the level above: zero-length legs naming
  # stations so the level above needn't know what's inside here.
  centreline
    sd length 0.001 metres
    data normal from to length compass clino
    tea-junction@bac-to-forever-changed	tea-junction	0	0	0
  endcentreline

  # Grade 5 surveys go here, each with equates tying it to the rest, e.g.
  #   input 2025-01-01-passage/passage.th
  #   centreline
  #     equate 1@passage 12@somesurvey
  #   endcentreline

endsurvey
